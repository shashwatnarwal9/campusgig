# Copy to .env and fill in real values. Never commit .env.

# development | production
ENVIRONMENT=development

# PostgreSQL. Use the psycopg (v3) driver.
DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME@localhost:5432/campusgig

# Signs session material.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# The app refuses to start in production while this is the default value.
AUTH_SECRET=dev-only-insecure-secret-change-me

# Comma-separated list of allowed browser origins (CORS).
FRONTEND_URL=http://localhost:5173

# Institutional access
ALLOWED_EMAIL_DOMAIN=thapar.edu

# Session
SESSION_COOKIE_NAME=campusgig_session
SESSION_TTL_MINUTES=10080

# Login lockout
LOGIN_MAX_FAILURES=10
LOGIN_LOCKOUT_MINUTES=15

# Uploaded avatars and resumes. Relative to the backend directory.
MEDIA_ROOT=media
MAX_AVATAR_BYTES=2097152
MAX_RESUME_BYTES=5242880

# Used by pytest only. Defaults to DATABASE_URL with a _test suffix.
# TEST_DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME@localhost:5432/campusgig_test
